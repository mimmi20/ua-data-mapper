{
  "name": "mimmi20/ua-data-mapper",
  "description": "a class to map the results of different useragent parsers",
  "license": "MIT",
  "type": "library",
  "keywords": [
    "Browser",
    "user agent",
    "http",
    "parser",
    "user-agent"
  ],
  "authors": [
    {
      "name": "Thomas Müller",
      "homepage": "https://github.com/mimmi20",
      "role": "Developer"
    },
    {
      "name": "Contributors",
      "homepage": "https://github.com/mimmi20/ua-data-mapper/graphs/contributors"
    }
  ],
  "homepage": "https://github.com/mimmi20/ua-data-mapper",
  "support": {
    "issues": "https://github.com/mimmi20/ua-data-mapper/issues",
    "source": "https://github.com/mimmi20/ua-data-mapper"
  },
  "require": {
    "php": "~8.5.0 || ~8.6.0",
    "ext-mbstring": "*",
    "mimmi20/browser-detector-version": "^14.0.3",
    "mimmi20/browser-detector-versioninterface": "^2.0.3",
    "mimmi20/ua-browser-type": "^13.0.4",
    "mimmi20/ua-device-type": "^13.0.2"
  },
  "require-dev": {
    "ergebnis/composer-normalize": "^2.57.0",
    "infection/infection": "^0.35.11",
    "jbelien/phpstan-sarif-formatter": "^1.2.0",
    "mimmi20/coding-standard": "^8.0.32",
    "phpstan/extension-installer": "^1.4.3",
    "phpstan/phpstan": "^2.3.6",
    "phpstan/phpstan-deprecation-rules": "^2.0.5",
    "phpstan/phpstan-phpunit": "^2.1.2",
    "phpunit/phpunit": "^13.4.7",
    "rector/rector": "^2.8.5",
    "shipmonk/composer-dependency-analyser": "^1.8.4",
    "symplify/phpstan-rules": "^14.19.3",
    "tomasvotruba/cognitive-complexity": "^1.3.0",
    "tomasvotruba/type-coverage": "^2.5.1",
    "tomasvotruba/unused-public": "^2.2.1"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "UaDataMapper\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "UaDataMapperTest\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "ergebnis/composer-normalize": true,
      "infection/extension-installer": true,
      "phpstan/extension-installer": true
    },
    "lock": false,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "extra": {
    "composer-normalize": {
      "indent-size": 2,
      "indent-style": "space"
    }
  }
}
